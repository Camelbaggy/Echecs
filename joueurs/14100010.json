hucky.","url":"https://fr.wikipedia.org/wiki/Vassili_Ivantchouk","licence":"CC BY-SA 4.0","maj":"2026-11-27T00:42:11Z"},"palmares":[{"titre":"2016 Capablanca Memorial","annee":2016},{"titre":"European Individual Chess Championship 2004","annee":2004}],"palmares_maj":"2026-11-27T05:12:00Z","carriere":{"tournois":24,"victoires":1,"podiums":5,"top10":8,"meilleur_rang":1,"perf_moy":2588}}